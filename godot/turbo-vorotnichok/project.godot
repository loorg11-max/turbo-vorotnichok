; Турбо белый воротничок: каркас на Godot 4

config_version=5

[application]

config/name="Турбо белый воротничок"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/version="0.8"
config/icon="res://art/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="TurboVorotnichok"
boot_splash/bg_color=Color(0.07, 0.1, 0.2, 1)
boot_splash/image="res://art/icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
